class ArrayTask:
    def _init_(self, array):
        self._array = [float(x) for x in array]
    def solve_task_6(self, d):
        n = len(self._array)
        if n < 3:
            return 0
        count = 0
        total_sum = sum(self._array)
        left_sum = 0.0
        for i in range(1, n - 1):
            left_sum += self._array[i -1]
            right_sum = total_sum - left_sum -self._array[1]
            if abs(left_sum - right_sum) <=d:
               count =+ 1
        return count
     def print_aray(self):
        formatted_array = [int(x) if x.is_integer() else x for x in self._array]
        print(f"Текущий массив: {formatted_array}")
